        <module>gorse-sdk-spring-boot-autoconfigure</module>
        <module>gorse-sdk-spring-boot-starter</module>
    </modules>
    <groupId>com.guanshiyun</groupId>
    <artifactId>common-utils-cloud</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>common-utils-cloud</name>
    <description>common-utils-cloud</description>
    <url/>
    <licenses>
        <license/>
