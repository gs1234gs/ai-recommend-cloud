# ==================== Docker Build Ignore ====================
# 减少构建上下文大小，加速镜像构建

# Git
.git
.gitignore
.gitattributes

# IDE
.idea/
*.iml
.vscode/
.settings/
.project
.classpath

# Maven 编译产物（各模块的 target 目录）
**/target/

# 日志
*.log
logs/

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# Java
*.class
*.jar
*.war
*.ear

# 测试
test/
**/test/

# 临时文件
*.tmp
*.swp
*~

# Docker
Dockerfile
docker-compose.yml
.dockerignore

# 文档
*.md
README*
LICENSE*

# 密钥/证书（如需打包请移除此行）
# *.key
# *.pem
# *.crt
jwt_secret.key

# 数据库脚本（按需保留）
*.sql

# Node.js (如有前端)
node_modules/
npm-debug.log*

# 其他
ZMoudleTest/
ZMoudle/